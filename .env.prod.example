# ========================================
# ねこサービス 本番環境変数
# cp .env.prod.example .env.prod して値を設定
# .env.prod は git管理外（.gitignore に追加済み）
# ========================================

# --- ドメイン ---
DOMAIN_NAME=your-domain.jp

# --- PostgreSQL ---
POSTGRES_USER=neko
POSTGRES_PASSWORD=強力なパスワードに変えること
POSTGRES_DB=neko_db
DATABASE_URL=postgresql://neko:強力なパスワードに変えること@postgres:5432/neko_db

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- MinIO ---
MINIO_ROOT_USER=minioAdmin
MINIO_ROOT_PASSWORD=強力なパスワードに変えること
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=neko-media

# --- Backend ---
NODE_ENV=production
BACKEND_PORT=3001
JWT_SECRET=64文字以上のランダム文字列に変えること
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://your-domain.jp/api
FRONTEND_URL=https://your-domain.jp

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7

# --- Google Places API ---
GOOGLE_PLACES_API_KEY=AIza...
